<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Vigilante82PC</AssemblyName>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <!-- Keep trimming visible during NuGet's restore graph evaluation.  A
         configuration-conditioned value can be absent during implicit
         restore, which omits the ILLink tool pack and silently produces an
         untrimmed self-contained bundle. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization Condition="'$(Configuration)' == 'Release'">true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(Configuration)' == 'Release'">true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PythonExe Condition="Exists('$(ProgramFiles)\Blender Foundation\Blender 4.5\4.5\python\bin\python.exe')">$(ProgramFiles)\Blender Foundation\Blender 4.5\4.5\python\bin\python.exe</PythonExe>
    <PythonExe Condition="'$(PythonExe)' == ''">python</PythonExe>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\tools\recompone-reference\RecompOne.Runtime\RecompOne.Runtime.csproj" />
    <!-- prepare_reference.py copies this file into
         reference-v8-2/generated/recompiled/, so every path here has to
         resolve from both that directory and this one. Both sit three levels
         below the repository root, which is what the ProjectReference above
         already relies on; the hand-written seams use the same form so a
         regeneration cannot overwrite the staged project with paths that
         only worked from the template's own directory. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\V82NativeControlOptions.cs"
             Link="V82NativeControlOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\V82NativeVideoOption.cs"
             Link="V82NativeVideoOption.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\V82NativeVideoPage.cs"
             Link="V82NativeVideoPage.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\V82NativeTextPageInput.cs"
             Link="V82NativeTextPageInput.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\LEVELS_N64_DREAMLND.cs"
             Link="LEVELS_N64_DREAMLND.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- GLFW uses the dynamic MSVC runtime. Bundle the official redistributable
         app-locally so the single-file release has no VC Redist prerequisite. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\reference-host\runtime\win-x64\vcruntime140.dll"
             Link="vcruntime140.dll"
             TargetPath="vcruntime140.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)\main.cs')">
    <!-- The source-tree reference host supplies its own top-level Program but
         exercises the current generated dispatch tables and entry point. The
         same project file is copied into generated/recompiled, where default
         compile items already include these files. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\reference-v8-2\generated\recompiled\*.cs"
             Exclude="$(MSBuildThisFileDirectory)..\..\..\reference-v8-2\generated\recompiled\Program.cs"
             Link="Generated\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- Silk discovers input backends through assembly attributes. Keep that
         metadata and both GLFW platform implementations in trimmed desktop
         builds. -->
    <TrimmerRootAssembly Include="Silk.NET.Input.Glfw" />
    <TrimmerRootAssembly Include="Silk.NET.Windowing.Glfw" />
  </ItemGroup>
  <Target Name="EnsureGeneratedVehicleSeams"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(MSBuildProjectDirectory)\main.cs')">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\apply_vehicle_engine_patches.py&quot; --source &quot;$(MSBuildProjectDirectory)\main.cs&quot;" />
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\apply_native_selector_patches.py&quot; --source &quot;$(MSBuildProjectDirectory)\SHELL_SHELL.cs&quot; --main-source &quot;$(MSBuildProjectDirectory)\main.cs&quot;" />
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\apply_native_options_patches.py&quot; --shell-source &quot;$(MSBuildProjectDirectory)\SHELL_SHELL.cs&quot; --main-source &quot;$(MSBuildProjectDirectory)\main.cs&quot;" />
  </Target>
  <Target Name="GenerateConvertedDreamlandOverlay"
          BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\recompone-v8-2\port_dreamland_overlay.py&quot;" />
  </Target>
</Project>
