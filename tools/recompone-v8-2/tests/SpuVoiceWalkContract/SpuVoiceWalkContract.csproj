<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Hardware>../../../recompone-reference/RecompOne.Runtime/Hardware</Hardware>
    <SpuSource Condition="'$(SpuSource)' == ''">$(Hardware)/Spu.cs</SpuSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SpuSource)" Link="Spu.cs" />
    <Compile Include="$(Hardware)/CddaAudio.cs;$(Hardware)/XaAudio.cs" />
  </ItemGroup>
</Project>
