<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NoWarn>CS0162</NoWarn></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../recompone-reference/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    <Compile Include="$(IntermediateOutputPath)Native.cs" />
    <None Update="*-requests.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="quest-matrix.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareNativeAllocator" BeforeTargets="CoreCompile">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="python prepare_fixture.py &quot;$(IntermediateOutputPath)Native.cs&quot;" />
  </Target>
</Project>
